{
  "name": "light-scripts",
  "version": "3.3.1",
  "description": "Build scripts for Lighting Beetle* light framework",
  "repository": {
    "type": "git",
    "url": "https://github.com/lightingbeetle/light-scripts"
  },
  "scripts": {
    "lint-staged": "lint-staged",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "author": "Lighting Beetle, Adam Mockor",
  "license": "MIT",
  "dependencies": {
    "@babel/core": "~7.23.2",
    "@babel/preset-env": "~7.23.2",
    "autoprefixer": "~10.4.16",
    "babel-loader": "~8.3.0",
    "browser-sync": "~2.29.3",
    "bs-pretty-message": "~1.0.8",
    "connect-modrewrite": "~0.10.2",
    "cssnano": "~5.1.7",
    "del": "~6.1.1",
    "eslint": "~7.32.0",
    "eslint-loader": "~4.0.2",
    "glob": "~10.3.10",
    "gulp": "~4.0.2",
    "gulp-cache": "~1.1.3",
    "gulp-cached": "~1.1.1",
    "gulp-changed": "~4.0.3",
    "gulp-cheerio": "~1.0.0",
    "gulp-concat": "~2.6.1",
    "gulp-data": "~1.3.1",
    "gulp-extend": "~0.3.0",
    "gulp-filter": "~7.0.0",
    "gulp-help": "~1.6.1",
    "gulp-if": "~3.0.0",
    "gulp-imagemin": "~8.0.0",
    "gulp-modernizr": "~5.0.0",
    "gulp-notify": "~4.0.0",
    "gulp-plumber": "~1.2.1",
    "gulp-postcss": "~9.0.1",
    "gulp-pug": "~5.0.0",
    "gulp-pug-inheritance": "~0.2.1",
    "gulp-rename": "~2.0.0",
    "gulp-rev": "~9.0.0",
    "gulp-rev-all": "~3.0.0",
    "gulp-rev-replace": "~0.4.4",
    "gulp-rsync": "~0.1.0",
    "gulp-sass": "~5.1.0",
    "gulp-size": "~4.0.1",
    "gulp-sourcemaps": "~3.0.0",
    "gulp-stylelint": "~13.0.0",
    "gulp-svgstore": "~9.0.0",
    "gulp-util": "~3.0.8",
    "gulp-yaml-merge": "~2.0.0",
    "js-yaml": "~4.1.0",
    "lodash": "~4.17.21",
    "map-stream": "~0.0.7",
    "md5-file": "~5.0.0",
    "node-notifier": "~10.0.1",
    "postcss": "^8.4.31",
    "postcss-inline-svg": "~6.0.0",
    "pug": "~3.0.2",
    "sass": "^1.69.4",
    "vinyl-named": "~1.1.0",
    "webpack": "~4.47.0",
    "yargs": "~17.7.2"
  },
  "devDependencies": {
    "@babel/plugin-transform-class-properties": "^7.22.5",
    "@babel/plugin-transform-private-methods": "^7.22.5",
    "babel-plugin-transform-object-rest-spread": "^6.26.0",
    "eslint-config-airbnb-base": "~15.0.0",
    "eslint-plugin-import": "~2.29.0",
    "lint-staged": "~15.0.2",
    "pre-commit": "~1.2.2"
  },
  "pre-commit": "lint-staged",
  "lint-staged": {
    "*.js": [
      "eslint --fix --rule 'no-console: 2'",
      "git add"
    ]
  },
  "babel": {
    "presets": [
      [
        "env",
        {
          "modules": false,
          "loose": true,
          "targets": {
            "browsers": [
              "defaults"
            ]
          }
        }
      ]
    ],
    "plugins": [
      "transform-object-rest-spread",
      "transform-class-properties"
    ]
  },
  "eslintConfig": {
    "extends": "airbnb-base",
    "rules": {
      "comma-dangle": [
        "error",
        {
          "arrays": "always-multiline",
          "objects": "always-multiline",
          "imports": "always-multiline",
          "exports": "always-multiline",
          "functions": "never"
        }
      ]
    },
    "globals": {
      "$": true,
      "jQuery": true,
      "Modernizr": true,
      "window": true
    },
    "env": {
      "browser": true
    },
    "parserOptions": {
      "ecmaFeatures": {
        "experimentalObjectRestSpread": true
      }
    }
  },
  "stylelint": {
    "rules": {}
  },
  "overrides": {
    "chokidar": "^3.0.0",
    "glob-stream": "^7.0.0",
    "glob-parent": "^6.0.0",
    "glob-watcher": "^6.0.0",
    "micromatch": "^4.0.0"
  }
}
